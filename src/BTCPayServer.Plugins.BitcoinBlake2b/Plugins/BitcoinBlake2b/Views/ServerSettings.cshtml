@using BTCPayServer.Plugins.BitcoinBlake2b.Chain
@using BTCPayServer.Plugins.BitcoinBlake2b.Rates
@model Btcb2ServerSettingsViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(UIBitcoinBlake2bServerController.MenuItemId, Btcb2.ChainName));
    var sourcesLocked = Model.ConfiguredByEnvironment;
}

<form method="post" asp-action="ServerSettings">
    <div class="sticky-header">
        <h2 class="my-1">@ViewData["Title"]</h2>
        <div>
            <button type="submit" name="command" value="test" class="btn btn-secondary" id="TestSources" disabled="@sourcesLocked">Test sources</button>
            <button type="submit" name="command" value="save" class="btn btn-primary" id="SaveServerSettings">Save</button>
        </div>
    </div>
    <partial name="_StatusMessage" />
    @if (!ViewContext.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-danger"></div>
    }

    <p class="text-secondary">
        Server-wide settings for accepting @Btcb2.ChainName. This server follows <strong>@Model.Chain</strong>.
        Stores set up their own wallets under Wallets.
    </p>

    <div class="row">
        <div class="col-xl-8">
            <h3 class="mt-4 mb-3">Display name</h3>
            <div class="form-group">
                <label asp-for="DisplayName" class="form-label">Name shown to customers and merchants</label>
                <input asp-for="DisplayName" class="form-control w-auto" maxlength="20" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
                <div class="form-text">
                    Checkout and this plugin's pages use the new name right away; other BTCPay pages after a restart.
                    Internally the currency code stays @Btcb2.CryptoCode, because BTCPay treats "XBT" as Bitcoin.
                </div>
            </div>

            <h3 class="mt-5 mb-3">Chain data sources</h3>
            <p class="text-secondary">
                The servers BTCPay asks about payments. Each one must prove it follows @Btcb2.ChainName before it's used,
                so a Bitcoin (BTC) explorer is never mistaken for an XBT one.
            </p>
            @if (sourcesLocked)
            {
                <div class="alert alert-info" role="alert">
                    The sources are set by the <code>BTCPAY_BTCB2_ESPLORA</code> environment variable and can't be changed here.
                </div>
            }

            <fieldset disabled="@sourcesLocked">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" asp-for="Mode" value="@ChainSourceMode.Public" id="ModePublic" />
                    <label class="form-check-label" for="ModePublic">
                        <strong>Public explorers</strong>
                        <div class="form-text mt-0">
                            @string.Join(", ", Model.PublicSources.Select(u => new Uri(u).Host)).
                            @(Model.PublicRequiredAgreement > 1 ? $"{Model.PublicRequiredAgreement} independent explorers must agree." : "")
                            Public servers could be wrong or go offline, and they see which addresses you watch.
                        </div>
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" asp-for="Mode" value="@ChainSourceMode.Own" id="ModeOwn" />
                    <label class="form-check-label" for="ModeOwn">
                        <strong>My own sources only</strong>
                        <div class="form-text mt-0">Your own explorer or Electrum server, trusted on its own. The most private option.</div>
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" asp-for="Mode" value="@ChainSourceMode.OwnWithPublicCheck" id="ModeOwnWithPublicCheck" />
                    <label class="form-check-label" for="ModeOwnWithPublicCheck">
                        <strong>My own sources, cross-checked with the public explorers</strong>
                        <div class="form-text mt-0">Any two sources must agree before a payment counts.</div>
                    </label>
                </div>
                <div class="form-group">
                    <label asp-for="OwnSources" class="form-label">My own sources, one per line</label>
                    <textarea asp-for="OwnSources" class="form-control font-monospace" rows="3" spellcheck="false"
                              placeholder="https://mempool.mynode.local/api&#10;ssl://electrs.mynode.local:50002"></textarea>
                    <span asp-validation-for="OwnSources" class="text-danger"></span>
                    <div class="form-text">
                        An explorer API URL (mempool or Esplora, such as <code>https://host/api</code>), or an Electrum server
                        (electrs or Fulcrum) as <code>ssl://host:50002</code>, <code>tcp://host:50001</code> or <code>host:50002:s</code>.
                        For a self-signed certificate, add its SHA-256 fingerprint: <code>ssl://host:50002?fingerprint=AB:CD:…</code>
                    </div>
                </div>
            </fieldset>

            @if (Model.Test is not null)
            {
                <h4 class="mt-4 mb-2">Test results</h4>
                <partial name="_SourceStatus" model="Model.Test" />
            }

            <h4 class="mt-4 mb-2">In use now: @Model.Current?.Description</h4>
            @if (Model.Current is not null)
            {
                <partial name="_SourceStatus" model="Model.Current" />
            }

            <h3 class="mt-5 mb-3" id="pricing">Pricing</h3>
            <p class="text-secondary">
                The XBT price comes from these exchanges, refreshed every minute. Each store can add its own
                adjustment on its <em>Wallets → @Model.DisplayName</em> page, and BTCPay's store rate settings still apply.
            </p>
            @if (Model.Price is not null)
            {
                <partial name="_PriceStatus" model="Model.Price" />
            }
            <div class="form-group mt-4">
                <label class="form-label">Exchanges to use</label>
                @foreach (var (name, market) in Model.Exchanges)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="EnabledExchanges" value="@name" id="Exchange-@name"
                               checked="@(Model.EnabledExchanges?.Contains(name) == true)" />
                        <label class="form-check-label" for="Exchange-@name">@name (@market)</label>
                    </div>
                }
                <span asp-validation-for="EnabledExchanges" class="text-danger"></span>
                <div class="form-text">
                    With two exchanges, they must agree. If one is down, the other is used only while it stays close to
                    the last price both agreed on. With only one exchange selected, its price is trusted alone.
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 form-group">
                    <label asp-for="MaxSpreadPercent" class="form-label">Ignore an exchange whose spread is wider than</label>
                    <div class="input-group w-auto">
                        <input asp-for="MaxSpreadPercent" type="number" step="0.1" min="0.5" max="25" class="form-control" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="MaxSpreadPercent" class="text-danger"></span>
                    <div class="form-text">The gap between the best buy and sell offers. A wide gap means a thin market that is easy to move.</div>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="MaxDivergencePercent" class="form-label">Stop pricing if exchanges disagree by more than</label>
                    <div class="input-group w-auto">
                        <input asp-for="MaxDivergencePercent" type="number" step="0.1" min="0.5" max="25" class="form-control" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="MaxDivergencePercent" class="text-danger"></span>
                    <div class="form-text">Better to offer no XBT than a wrong price.</div>
                </div>
            </div>

            <h3 class="mt-5 mb-3">Stores</h3>
            <div class="d-flex align-items-center">
                <input asp-for="AllowStoreSources" type="checkbox" class="btcpay-toggle me-3" disabled="@sourcesLocked" />
                <label asp-for="AllowStoreSources" class="form-check-label">Let store owners use their own chain data sources</label>
            </div>
            <div class="form-text">
                BTCPay will connect to whatever addresses store owners enter. Turn this on only if you trust every store owner,
                since those addresses could point into this server's private network.
            </div>
        </div>
    </div>
</form>
