@using BTCPayServer.Plugins.BitcoinBlake2b.Chain
@using BTCPayServer.Plugins.BitcoinBlake2b.Rates
@model Btcb2WalletViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(UIBitcoinBlake2bStoreController.MenuItemId, $"{Model.DisplayName} wallet"));
    var storeId = Context.GetRouteValue("storeId");
    var expectedKeys = Model.Chain == Btcb2Chain.Mainnet ? "zpub, ypub or xpub" : "vpub, upub or tpub";
}

<div class="sticky-header">
    <h2 class="my-1">@ViewData["Title"]</h2>
</div>
<partial name="_StatusMessage" />

<p class="text-secondary">
    Accept @Model.DisplayName (@Btcb2.ChainName, @Model.Chain) with a watch-only wallet.
    BTCPay derives a new receive address for every invoice. It never holds your spending keys.
</p>

<div class="alert alert-warning" role="alert">
    <strong>Use a wallet dedicated to @Model.DisplayName.</strong>
    @Model.DisplayName addresses look exactly like Bitcoin addresses, and the same keys control coins on both chains.
    Never use the wallet that holds your BTC.
</div>

@if (Model.Configured)
{
    @if (Model.ChainMismatch)
    {
        <div class="alert alert-danger" role="alert">
            This wallet was set up for a different chain than this server follows (@Model.Chain). @Model.DisplayName is unavailable at checkout until you replace it.
        </div>
    }
    <div class="row">
        <div class="col-xl-8">
            <h3 class="mb-3">Current wallet</h3>
            <div class="form-group">
                <label class="form-label">Account public key or descriptor</label>
                <vc:truncate-center text="@Model.AccountOriginal" padding="20" classes="form-control-plaintext" copy="true" />
            </div>
            @if (Model.Addresses.Length > 0)
            {
                <div class="form-group">
                    <label class="form-label">First receive addresses</label>
                    <ol start="0" class="font-monospace small mb-1" data-testid="BitcoinBlake2b-Addresses">
                        @foreach (var address in Model.Addresses)
                        {
                            <li>@address</li>
                        }
                    </ol>
                    <div class="form-text">
                        The next invoice uses address #@Model.NextIndex. Set your wallet's gap limit well above the number of unpaid invoices you expect, or it may not show payments to later addresses.
                    </div>
                </div>
            }

            <form method="post" asp-action="UpdateSettings" asp-route-storeId="@storeId" class="mt-4">
                <div class="d-flex align-items-center mb-3">
                    <input type="checkbox" class="btcpay-toggle me-3" id="enabled" name="enabled" value="true" checked="@Model.Enabled" />
                    <label class="form-check-label" for="enabled">Accept @Model.DisplayName at checkout</label>
                </div>
                <div class="form-group">
                    <label class="form-label" for="confirmationsRequired">Confirmations before an invoice is settled</label>
                    <input type="number" class="form-control w-auto" id="confirmationsRequired" name="confirmationsRequired" min="0" max="100"
                           value="@Model.ConfirmationsRequired" placeholder="@Model.SpeedPolicyConfirmations" />
                    <div class="form-text">
                        Leave empty to follow the store's speed policy (currently @Model.SpeedPolicyConfirmations).
                        @Model.DisplayName is a young chain whose hashrate can be rented, so more confirmations are safer for large amounts.
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" id="SaveSettings">Save</button>
            </form>

            <h3 class="mt-5 mb-3">Replace or remove wallet</h3>
            <p class="text-secondary">Existing invoices keep using the addresses they were given.</p>
            <form method="post" asp-action="Remove" asp-route-storeId="@storeId" class="d-inline">
                <button type="submit" class="btn btn-outline-danger" id="RemoveWallet">Remove wallet</button>
            </form>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-xl-8">
        <h3 class="mb-3">@(Model.Configured ? "Use a different wallet" : "Set up your wallet")</h3>
        <form method="post" asp-action="Preview" asp-route-storeId="@storeId">
            <div class="form-group">
                <label asp-for="WalletKey" class="form-label">Account public key or output descriptor</label>
                <textarea asp-for="WalletKey" class="form-control font-monospace" rows="3" placeholder="@expectedKeys…" autocomplete="off" spellcheck="false"></textarea>
                <span asp-validation-for="WalletKey" class="text-danger"></span>
                <div class="form-text">
                    From an @Model.DisplayName-capable wallet such as the Sparrow BLAKE2b build. A @expectedKeys gives native SegWit, nested SegWit or legacy addresses respectively. Never paste a private key.
                </div>
            </div>
            <button type="submit" class="btn btn-secondary" id="PreviewWallet">Preview addresses</button>
        </form>

        @if (Model.PreviewAddresses is { Length: > 0 })
        {
            <form method="post" asp-action="Save" asp-route-storeId="@storeId" class="mt-4">
                <input type="hidden" asp-for="WalletKey" />
                <label class="form-label">Compare these with the first receive addresses in your wallet</label>
                <ol start="0" class="font-monospace small" data-testid="BitcoinBlake2b-PreviewAddresses">
                    @foreach (var address in Model.PreviewAddresses)
                    {
                        <li>@address</li>
                    }
                </ol>
                <div class="form-check mb-2">
                    <input asp-for="ConfirmAddressesMatch" type="checkbox" class="form-check-input" />
                    <label asp-for="ConfirmAddressesMatch" class="form-check-label">These addresses match my wallet's receive addresses.</label>
                    <span asp-validation-for="ConfirmAddressesMatch" class="text-danger d-block"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="ConfirmDedicatedWallet" type="checkbox" class="form-check-input" />
                    <label asp-for="ConfirmDedicatedWallet" class="form-check-label">This wallet is used only for @Model.DisplayName, never for BTC.</label>
                    <span asp-validation-for="ConfirmDedicatedWallet" class="text-danger d-block"></span>
                </div>
                <button type="submit" class="btn btn-primary" id="SaveWallet">Save wallet</button>
            </form>
        }
    </div>
</div>

@if (Model.Price is not null)
{
    var adjustment = Model.AdjustmentPercent;
    <div class="row mt-5">
        <div class="col-xl-8">
            <h3 class="mb-3" id="pricing">Pricing</h3>
            <p class="text-secondary">Where this store's @Model.DisplayName price comes from.</p>
            <partial name="_PriceStatus" model="Model.Price" />

            <div class="mt-4 mb-3" data-testid="BitcoinBlake2b-StorePrice">
                @if (Model.StoreRate is { } storeRate && storeRate > 0)
                {
                    <p class="mb-1">
                        <strong>This store's price: 1 @Model.DisplayName = @storeRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) @Model.StoreCurrency</strong>
                        <span class="text-secondary">(what new invoices use)</span>
                    </p>
                    <p class="text-secondary mb-0">
                        A 100 @Model.StoreCurrency invoice costs @((100m / storeRate).ToString("0.00000000", System.Globalization.CultureInfo.InvariantCulture)) @Model.DisplayName.
                    </p>
                }
                else
                {
                    <p class="text-danger mb-0"><strong>This store can't price @Model.DisplayName right now, so its invoices won't offer it.</strong></p>
                }
                <ul class="text-secondary small mt-2 mb-0">
                    <li>Exchange price@(Model.StoreCurrency == "USD" ? "" : $", converted to {Model.StoreCurrency} with your store's Bitcoin rates")</li>
                    <li>Your @Model.DisplayName adjustment below: @(adjustment == 0 ? "none" : $"{(adjustment > 0 ? "+" : "")}{adjustment}%")</li>
                    <li>
                        Your store's spread: @Model.StoreSpreadPercent% (applies to all currencies, set in
                        <a asp-area="" asp-controller="UIStores" asp-action="Rates" asp-route-storeId="@storeId">Settings → Rates</a>)
                    </li>
                </ul>
                @if (Model.UsesRateScript && !Model.RateScriptPricesXbt)
                {
                    <div class="alert alert-warning mt-3 mb-0" role="alert">
                        Your store uses a custom rate script without @Btcb2.CryptoCode rules, so @Model.DisplayName can't be priced.
                        Add these lines to it in <a asp-area="" asp-controller="UIStores" asp-action="Rates" asp-route-storeId="@storeId">Settings → Rates</a>:
                        <pre class="mb-0 mt-2">@string.Join("\n", Btcb2.DefaultRateRules)</pre>
                    </div>
                }
                else if (Model.UsesRateScript)
                {
                    <p class="form-text mb-0">Your store's custom rate script decides the @Model.DisplayName price: @Model.StoreRateRule</p>
                }
            </div>

            <form method="post" asp-action="UpdatePricing" asp-route-storeId="@storeId">
                <div class="form-group">
                    <label class="form-label" for="adjustmentPercent">@Model.DisplayName price adjustment</label>
                    <div class="input-group w-auto">
                        <input type="number" class="form-control" id="adjustmentPercent" name="adjustmentPercent" step="0.1"
                               min="@Btcb2StorePricingSettings.MinAdjustmentPercent" max="@Btcb2StorePricingSettings.MaxAdjustmentPercent"
                               value="@adjustment.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text">
                        How much more customers pay when they pay in @Model.DisplayName, for example to cover price swings before you sell it.
                        2 means a 100 @Model.StoreCurrency invoice costs 102 @Model.StoreCurrency worth of @Model.DisplayName. A negative number gives a discount.
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" id="SavePricing">Save adjustment</button>
            </form>
            @if (User.IsInRole(Roles.ServerAdmin))
            {
                <p class="form-text mt-3 mb-0">
                    Choose the exchanges and their safety limits in
                    <a asp-area="@Plugin.Area" asp-controller="UIBitcoinBlake2bServer" asp-action="ServerSettings" asp-fragment="pricing">server settings</a>.
                </p>
            }
        </div>
    </div>
}

@if (Model.Sources is not null)
{
    <div class="row mt-5">
        <div class="col-xl-8">
            <h3 class="mb-3">Chain data sources</h3>
            <p class="text-secondary">The servers BTCPay asks about this store's @Model.DisplayName payments.</p>
            @if (User.IsInRole(Roles.ServerAdmin))
            {
                <p class="text-secondary">
                    To use your own explorer or Electrum server instead of the public explorers, go to
                    <a asp-area="@Plugin.Area" asp-controller="UIBitcoinBlake2bServer" asp-action="ServerSettings">server settings</a>
                    and choose <em>My own sources only</em>.
                </p>
            }
            else if (!Model.CanChooseSources)
            {
                <p class="text-secondary">This server's admin chooses these sources.</p>
            }
            @if (Model.CanChooseSources)
            {
                <p class="text-secondary">Your own sources must be reachable on the public internet.</p>
                <form method="post" asp-action="UpdateSources" asp-route-storeId="@storeId" class="mb-4">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="sourceMode" value="@ChainSourceMode.Public" id="StoreModePublic" checked="@(Model.SourceMode == ChainSourceMode.Public)" />
                        <label class="form-check-label" for="StoreModePublic">Use this server's sources</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="sourceMode" value="@ChainSourceMode.Own" id="StoreModeOwn" checked="@(Model.SourceMode == ChainSourceMode.Own)" />
                        <label class="form-check-label" for="StoreModeOwn">My own sources only, trusted on their own</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="sourceMode" value="@ChainSourceMode.OwnWithPublicCheck" id="StoreModeOwnWithPublicCheck" checked="@(Model.SourceMode == ChainSourceMode.OwnWithPublicCheck)" />
                        <label class="form-check-label" for="StoreModeOwnWithPublicCheck">My own sources, cross-checked with the public explorers (any two must agree)</label>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="ownSources">My own sources, one per line</label>
                        <textarea class="form-control font-monospace" id="ownSources" name="ownSources" rows="3" spellcheck="false"
                                  placeholder="https://mempool.mynode.local/api&#10;ssl://electrs.mynode.local:50002">@Model.OwnSources</textarea>
                        <div class="form-text">
                            An explorer API URL (<code>https://host/api</code>) or an Electrum server (<code>ssl://host:50002</code>, <code>tcp://host:50001</code>).
                            For a self-signed certificate: <code>ssl://host:50002?fingerprint=AB:CD:…</code>
                        </div>
                    </div>
                    <button type="submit" name="command" value="test" class="btn btn-secondary" id="TestStoreSources">Test sources</button>
                    <button type="submit" name="command" value="save" class="btn btn-primary" id="SaveStoreSources">Save sources</button>
                </form>
                @if (Model.TestSources is not null)
                {
                    <h4 class="mb-2">Test results</h4>
                    <partial name="_SourceStatus" model="Model.TestSources" />
                }
            }
            <h4 class="mt-4 mb-2">In use now: @Model.Sources.Description</h4>
            <partial name="_SourceStatus" model="Model.Sources" />
        </div>
    </div>
}
